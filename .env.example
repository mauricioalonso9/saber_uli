# Saber Uli: variables de entorno (T013).
#
# Copie este archivo a `.env` (está en .gitignore) y reemplace TODOS los valores de ejemplo.
# Nunca suba un `.env` ni secretos reales al repositorio. Para generar un secreto aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# La validación de cada variable está en backend/src/saber_uli/config.py.

# ---------------------------------------------------------------------------------------------
# Base de datos (solo la usa Compose; research R-07)
# ---------------------------------------------------------------------------------------------
# Nombre de la base de datos de la aplicación.
POSTGRES_DB=saber_uli
# Contraseña del superusuario de la imagen de PostgreSQL. Ningún servicio la usa en ejecución.
POSTGRES_PASSWORD=cambie-esta-contrasena
# Contraseña del rol saber_migrator (DDL; solo el servicio migrate).
SABER_MIGRATOR_PASSWORD=cambie-esta-contrasena
# Contraseña del rol saber_app (DML; api, worker y beat).
SABER_APP_PASSWORD=cambie-esta-contrasena
# Contraseña del rol saber_bi (solo lectura de analytics; spec 008).
SABER_BI_PASSWORD=cambie-esta-contrasena

# Compose arma estas URL a partir de las contraseñas anteriores. Defínalas solo para ejecutar el
# backend fuera de Docker (por ejemplo `uv run uvicorn ...` en el host).
# Conexión de la aplicación con el rol saber_app (debe empezar por postgresql+asyncpg://).
# DATABASE_URL=postgresql+asyncpg://saber_app:cambie-esta-contrasena@localhost:5432/saber_uli
# Conexión de las migraciones con el rol saber_migrator.
# MIGRATION_DATABASE_URL=postgresql+asyncpg://saber_migrator:cambie-esta-contrasena@localhost:5432/saber_uli
# Redis: broker de Celery, caché de auth_epoch y límites de peticiones (redis:// o rediss://).
# REDIS_URL=redis://localhost:6379/0
# Producción (compose.prod.yaml): Redis exige esta contraseña y Compose arma REDIS_URL con ella.
# Sin caracteres reservados de URL; genérela, por ejemplo, con secrets.token_urlsafe(32).
# REDIS_PASSWORD=cambie-esta-contrasena

# ---------------------------------------------------------------------------------------------
# Microsoft Entra ID (research R-10 a R-13)
# ---------------------------------------------------------------------------------------------
# Identificador del inquilino de la Universidad Libre (GUID). Solo se aceptan cuentas de este
# inquilino (FR-002).
ENTRA_TENANT_ID=00000000-0000-4000-8000-000000000000
# Identificador de la aplicación registrada en Entra ID (GUID).
ENTRA_CLIENT_ID=00000000-0000-4000-8000-000000000000
# Secreto de cliente de la aplicación. Renuévelo antes de su vencimiento (quickstart.md).
ENTRA_CLIENT_SECRET=cambie-este-secreto
# Autoridad OIDC. Opcional: por defecto https://login.microsoftonline.com/<ENTRA_TENANT_ID>/v2.0.
# Nunca use common, organizations ni consumers. En el perfil e2e: http://oidc:8080/<tenant>.
# ENTRA_AUTHORITY=https://login.microsoftonline.com/00000000-0000-4000-8000-000000000000/v2.0
# Inquilino externo simulado por el proveedor de prueba del perfil e2e (escenario de rechazo).
E2E_EXTERNAL_TENANT_ID=22222222-2222-4222-8222-222222222222

# ---------------------------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------------------------
# URL pública de la PWA, sin barra final. HTTPS obligatorio fuera de localhost. Se usa en los
# enlaces de los correos y en la URL de retorno de Microsoft.
PUBLIC_BASE_URL=http://localhost
# Dominios de correo institucionales, separados por comas. Un correo de estos dominios no puede
# recibir invitación de invitado (FR-008).
INSTITUTIONAL_EMAIL_DOMAINS=unilibre.edu.co

# ---------------------------------------------------------------------------------------------
# Sesiones (research R-14)
# ---------------------------------------------------------------------------------------------
# Clave para firmar los tokens de acceso (HS256). Mínimo 32 caracteres (256 bits).
JWT_SIGNING_KEY=cambie-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
# Identificador de la clave (claim kid), para rotarla sin invalidar sesiones de golpe.
JWT_KEY_ID=2026-10
# Clave de la cookie firmada que guarda state, nonce y PKCE durante el ingreso con Microsoft.
# Mínimo 32 caracteres.
SESSION_COOKIE_SECRET=cambie-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres

# ---------------------------------------------------------------------------------------------
# Correo (research R-30). En desarrollo, Mailpit: SMTP_HOST=mailpit, SMTP_PORT=1025,
# SMTP_STARTTLS=false y sin usuario.
# ---------------------------------------------------------------------------------------------
# Servidor SMTP.
SMTP_HOST=mailpit
# Puerto SMTP (por defecto 587).
SMTP_PORT=1025
# Usuario SMTP (vacío si el servidor no exige autenticación).
SMTP_USER=
# Contraseña SMTP (vacía si el servidor no exige autenticación).
SMTP_PASSWORD=
# Remitente de los correos: "Nombre <correo>" o solo el correo.
SMTP_FROM=Saber Uli <no-responder@unilibre.edu.co>
# Usar STARTTLS (true en producción; false con Mailpit).
SMTP_STARTTLS=false

# ---------------------------------------------------------------------------------------------
# Observabilidad (research R-32)
# ---------------------------------------------------------------------------------------------
# Trazas OpenTelemetry (desactivadas por defecto).
OTEL_ENABLED=false
# Nivel de los logs JSON: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------------------
# Reservadas para la spec 009 (notificaciones push). Déjelas vacías por ahora.
# ---------------------------------------------------------------------------------------------
# Clave pública VAPID.
VAPID_PUBLIC_KEY=
# Clave privada VAPID.
VAPID_PRIVATE_KEY=
