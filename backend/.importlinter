# Contratos de arquitectura (constitución, principio II; research R-04). Se verifican en CI con
# `lint-imports` (trabajo backend-quality).
#
# Capas de cada contexto, de afuera hacia adentro: api > infrastructure > application > domain.
# Así se cumplen las dos cadenas del plan (api → application → domain e
# infrastructure → application → domain): una capa interna nunca importa una externa, y la
# infraestructura nunca importa la API. La API puede usar adaptadores de infraestructura solo
# para el cableado de dependencias de FastAPI.
#
# Entre contextos solo se importa la fachada `<contexto>.application.public`; el kernel `shared`
# no depende de ningún contexto salvo por esa misma fachada.

[importlinter]
root_package = saber_uli
include_external_packages = True

[importlinter:contract:capas]
name = Capas hexagonales dentro de cada contexto
type = layers
containers =
    saber_uli.shared
    saber_uli.identity
    saber_uli.notifications
layers =
    api
    infrastructure
    application
    domain

[importlinter:contract:dominio-puro]
name = El dominio no depende de frameworks ni de infraestructura
type = forbidden
source_modules =
    saber_uli.shared.domain
    saber_uli.identity.domain
    saber_uli.notifications.domain
forbidden_modules =
    fastapi
    starlette
    sqlalchemy
    pydantic
    pydantic_settings
    celery
    redis
    httpx
    authlib
    jinja2
    saber_uli.config

[importlinter:contract:contextos-independientes]
name = identity y notifications solo se comunican por su fachada pública
type = independence
modules =
    saber_uli.identity
    saber_uli.notifications
ignore_imports =
    saber_uli.identity.** -> saber_uli.notifications.application.public
    saber_uli.notifications.** -> saber_uli.identity.application.public

[importlinter:contract:kernel-compartido]
name = El kernel compartido no depende de los contextos salvo por su fachada pública
type = forbidden
source_modules =
    saber_uli.shared
forbidden_modules =
    saber_uli.identity
    saber_uli.notifications
ignore_imports =
    saber_uli.shared.** -> saber_uli.identity.application.public
    saber_uli.shared.** -> saber_uli.notifications.application.public
