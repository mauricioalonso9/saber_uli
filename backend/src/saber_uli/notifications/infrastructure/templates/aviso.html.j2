{% extends "base.html.j2" %}
{% block title %}{{ title }}{% endblock %}
{% block content %}
<h1 style="font-size:20px;margin:0 0 16px;">{{ title }}</h1>
{% for paragraph in paragraphs %}
<p style="margin:0 0 12px;">{{ paragraph }}</p>
{% endfor %}
<p style="margin:24px 0 0;">
  <a href="{{ action_path | absolute_url }}" style="display:inline-block;padding:12px 20px;background:#15803d;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:bold;">{{ action_label }}</a>
</p>
{% endblock %}
