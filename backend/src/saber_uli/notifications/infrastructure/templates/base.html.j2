<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Saber Uli{% endblock %}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f7f5;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f7f5;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border-radius:12px;">
            <tr>
              <td style="padding:24px 28px 8px;font-size:20px;font-weight:bold;color:#15803d;">Saber Uli</td>
            </tr>
            <tr>
              <td style="padding:8px 28px 24px;font-size:16px;line-height:1.5;">
                {% block content %}{% endblock %}
              </td>
            </tr>
            <tr>
              <td style="padding:16px 28px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;">
                Universidad Libre · Saber Uli. Recibes este correo porque tienes acceso a la plataforma.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
